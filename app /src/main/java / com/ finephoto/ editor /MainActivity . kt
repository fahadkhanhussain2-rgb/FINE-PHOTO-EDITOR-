@Composable
fun FinePhotoEditorApp() {
    val viewModel: MainViewModel = viewModel()
    val state by viewModel.uiState.collectAsState()
    
    Surface(
        modifier = Modifier.fillMaxSize(),
        color = Color(0xFF121212)
